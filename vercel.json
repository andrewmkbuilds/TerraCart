{
  "name": "terracart-extension",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "rewrites": [
    { "source": "/", "destination": "/src/sidepanel/index.html" },
    { "source": "/sidepanel", "destination": "/src/sidepanel/index.html" },
    { "source": "/popup", "destination": "/src/popup/index.html" },
    { "source": "/onboarding", "destination": "/src/onboarding/index.html" }
  ]
}
